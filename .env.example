# Copia este archivo a .env (local) o .env.production y completa con tus propios valores.
# NUNCA pongas valores reales en este archivo — solo sirve como plantilla/documentación.
# En producción (Railway) las variables se configuran directamente en el panel de Variables del servicio,
# este archivo no se usa para eso.

# --- Servidor ---
NODE_ENV=development
PORT=3000

# --- Base de datos (TiDB/MySQL) ---
DATABASE_URL=

# --- Auth0 (autenticación) ---
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_MOBILE_CLIENT_ID=
OAUTH_SERVER_URL=

# --- JWT ---
JWT_SECRET=

# --- Forge (integración interna) ---
BUILT_IN_FORGE_API_KEY=
BUILT_IN_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_URL=

# --- Firebase (notificaciones push) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- VAPID (web push) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Resend (email) ---
RESEND_API_KEY=

# --- Owner / dueño de la app ---
OWNER_NAME=
OWNER_OPEN_ID=

# --- Frontend (Vite) — se empaquetan en el bundle del navegador, no son secretos ---
VITE_API_URL=http://localhost:3000
VITE_APP_ID=
VITE_APP_URL=
VITE_APP_TITLE=
VITE_APP_LOGO=
VITE_GOOGLE_MAPS_API_KEY=
VITE_OAUTH_PORTAL_URL=
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
VITE_VAPID_PUBLIC_KEY=

# --- Firebase (frontend) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=

# Copia este archivo a .env (local) o .env.production y completa con tus propios valores.
# NUNCA pongas valores reales en este archivo — solo sirve como plantilla/documentación.
# En producción (Railway) las variables se configuran directamente en el panel de Variables del servicio,
# este archivo no se usa para eso.
#
# Nota: Wompi, Alegra y el webhook de Resend ya NO se configuran por variables de entorno —
# viven en la tabla `platform_settings` y se administran desde Admin → Configuración en la app.
# RESEND_API_KEY abajo sigue existiendo como valor de respaldo (fallback) si aún no se ha
# configurado la clave desde ese panel.

# --- Servidor ---
NODE_ENV=development
PORT=3000

# --- Base de datos (TiDB/MySQL) ---
DATABASE_URL=

# --- Auth0 (autenticación) ---
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_MOBILE_CLIENT_ID=
OAUTH_SERVER_URL=

# --- JWT ---
JWT_SECRET=

# --- Forge (integración interna, heredada del scaffold original) ---
BUILT_IN_FORGE_API_KEY=
BUILT_IN_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_URL=

# --- Firebase Admin SDK (notificaciones push, servidor) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- VAPID (Web Push) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Resend (email) — ver nota arriba sobre platform_settings ---
RESEND_API_KEY=

# --- Owner / dueño de la app ---
OWNER_OPEN_ID=

# --- Frontend (Vite) — se empaquetan en el bundle del navegador, no son secretos ---
VITE_API_URL=http://localhost:3000
VITE_APP_ID=
VITE_APP_URL=
VITE_GOOGLE_MAPS_API_KEY=
VITE_VAPID_PUBLIC_KEY=

# --- Firebase (frontend) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
